	(text "Logic: host 3.3 V only.  Boost: separate regulated 5 V.\nAll blocks share GND. Identical net labels are connected."
		(at 126 232 0)
		(effects
			(font
				(size 1.1 1.1))
			(justify left top))
		(uuid "9d8c843c-8b32-4234-9b68-9048f8fb974d"))
	(text "MIPI D-PHY: three direct pairs, continuous GND.\nPCB + flex differential impedance: 100 ohm.\nNo DSI stubs/testpoints; no generic TVS on DSI.\nCheck FPC drawings and end-to-end continuity."
		(at 310 226 0)
		(effects
			(font
				(size 1.2 1.2))
			(justify left top))
		(uuid "32abae1d-571d-406f-9476-c2323a92b8e3"))
